  <bpmn:process id="LOAN" name="借款与还款审批流程（借款正向/还款反向档）" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="开始" />
    <bpmn:exclusiveGateway id="GW_LN" name="借贷方向分档" default="Flow_in_Task_1" />
    <bpmn:sequenceFlow id="Flow_start_gw" sourceRef="StartEvent_1" targetRef="GW_LN" />
    <bpmn:userTask id="Task_1" name="借款申请【员工】" flowable:candidateGroups="COMMON_EMP" />
    <bpmn:sequenceFlow id="Flow_in_Task_1" sourceRef="GW_LN" targetRef="Task_1" />
    <bpmn:userTask id="Task_2" name="直属上级审核【部门负责人】" flowable:candidateGroups="DIRECT_SUPERVISOR" />
    <bpmn:sequenceFlow id="Flow_in_Task_2" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:userTask id="Task_3" name="部门经理审核【部门经理】" flowable:candidateGroups="DEPT_MANAGER" />
    <bpmn:sequenceFlow id="Flow_in_Task_3" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:userTask id="Task_4" name="项目经理审核【项目经理】" flowable:candidateGroups="PROJECT_MANAGER" />
    <bpmn:sequenceFlow id="Flow_in_Task_4" sourceRef="Task_3" targetRef="Task_4" />
    <bpmn:userTask id="Task_5" name="基地总经理审批【基地总经理】" flowable:candidateGroups="BASE_GM" />
    <bpmn:sequenceFlow id="Flow_in_Task_5" sourceRef="Task_4" targetRef="Task_5" />
    <bpmn:userTask id="Task_6" name="财务总监审批【财务总监】" flowable:candidateGroups="CFO" />
    <bpmn:sequenceFlow id="Flow_in_Task_6" sourceRef="Task_5" targetRef="Task_6" />
    <bpmn:userTask id="Task_7" name="板块分管领导审批【板块分管领导】" flowable:candidateGroups="PLATE_DIV_LEADER" />
    <bpmn:sequenceFlow id="Flow_in_Task_7" sourceRef="Task_6" targetRef="Task_7" />
    <bpmn:userTask id="Task_8" name="总裁审批【总裁】" flowable:candidateGroups="PRESIDENT" />
    <bpmn:sequenceFlow id="Flow_in_Task_8" sourceRef="Task_7" targetRef="Task_8" />
    <bpmn:userTask id="Task_9" name="共享审核【共享会计】" flowable:candidateGroups="FSSC_AUDITOR" />
    <bpmn:sequenceFlow id="Flow_in_Task_9" sourceRef="Task_8" targetRef="Task_9" />
    <bpmn:userTask id="Task_10" name="共享主管复核【共享主管】" flowable:candidateGroups="FSSC_SUPERVISOR" />
    <bpmn:sequenceFlow id="Flow_in_Task_10" sourceRef="Task_9" targetRef="Task_10" />
    <bpmn:userTask id="Task_11" name="出纳放款【出纳】" flowable:candidateGroups="CASHIER" />
    <bpmn:sequenceFlow id="Flow_in_Task_11" sourceRef="Task_10" targetRef="Task_11" />
    <bpmn:userTask id="Task_12" name="总账制证【总账会计】" flowable:candidateGroups="FIN_GL" />
    <bpmn:sequenceFlow id="Flow_in_Task_12" sourceRef="Task_11" targetRef="Task_12" />
    <bpmn:userTask id="RP_1" name="出纳确认还款到账【出纳】" flowable:candidateGroups="CASHIER" />
    <bpmn:sequenceFlow id="Flow_GW_LN_RP_1" sourceRef="GW_LN" targetRef="RP_1" name="还款反向档"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${billType == 'EXP_REPAY'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:userTask id="RP_2" name="还款核销审核【财务审核岗】" flowable:candidateGroups="FIN_AUDIT" />
    <bpmn:sequenceFlow id="Flow_RP_2" sourceRef="RP_1" targetRef="RP_2" />
    <bpmn:sequenceFlow id="Flow_sgjoin_RP_2" sourceRef="RP_2" targetRef="EndEvent_1" />
    <bpmn:endEvent id="EndEvent_1" name="结束" />
    <bpmn:sequenceFlow id="Flow_end" sourceRef="Task_12" targetRef="EndEvent_1" />
  </bpmn:process>
