<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_TR_TRANSFER" targetNamespace="http://fssc">
  <bpmn:process id="TR_TRANSFER" name="资金上存/调拨审批流程" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="开始" />
    <bpmn:userTask id="Task_1" name="资金支付岗审核调拨申请与账户头寸【资金支付岗】" flowable:candidateGroups="FUND_PAY_STAFF" />
    <bpmn:exclusiveGateway id="Gw_2" default="Flow_2_def" />
    <bpmn:userTask id="Task_2" name="板块财务经理审批调拨（超 100 万）【板块财务经理】" flowable:candidateGroups="PLATE_FIN_MANAGER" />
    <bpmn:exclusiveGateway id="Gw_3" default="Flow_3_def" />
    <bpmn:userTask id="Task_3" name="财务总监审批调拨（超 200 万）【财务总监】" flowable:candidateGroups="CFO" />
    <bpmn:exclusiveGateway id="Gw_4" default="Flow_4_def" />
    <bpmn:userTask id="Task_4" name="总裁审批调拨（超 500 万）【总裁】" flowable:candidateGroups="PRESIDENT" />
    <bpmn:userTask id="Task_5" name="银企转账执行与回单影像齐套（作业池）【出纳】" flowable:candidateGroups="CASHIER" />
    <bpmn:endEvent id="EndEvent_1" name="结束" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_1in" sourceRef="Task_1" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="Flow_2_cond" name="金额&gt;1000000" sourceRef="Gw_2" targetRef="Task_2"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount > 1000000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2_def" name="金额不足/其他" sourceRef="Gw_2" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="Flow_2in" sourceRef="Task_2" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="Flow_3_cond" name="金额&gt;2000000" sourceRef="Gw_3" targetRef="Task_3"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount > 2000000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3_def" name="金额不足/其他" sourceRef="Gw_3" targetRef="Gw_4" />
    <bpmn:sequenceFlow id="Flow_3in" sourceRef="Task_3" targetRef="Gw_4" />
    <bpmn:sequenceFlow id="Flow_4_cond" name="金额&gt;5000000" sourceRef="Gw_4" targetRef="Task_4"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount > 5000000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4_def" name="金额不足/其他" sourceRef="Gw_4" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_4in" sourceRef="Task_4" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_5" targetRef="EndEvent_1" />
  </bpmn:process>
