  <bpmn:process id="AR_RECON" name="应收账款对账流程" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="开始" />
    <bpmn:userTask id="Task_1" name="导出客户 / 对账明细" flowable:assignee="${approver}" />
    <bpmn:userTask id="Task_2" name="打印对账明细加盖财务章" flowable:assignee="${approver}" />
    <bpmn:userTask id="Task_3" name="接收盖章明细 / 邮寄给客户" flowable:assignee="${approver}" />
    <bpmn:userTask id="Task_4" name="客户核对并出具余额调节表【应收会计】" flowable:candidateGroups="FIN_AR" />
    <bpmn:userTask id="Task_5" name="接收对账结果" flowable:assignee="${approver}" />
    <bpmn:userTask id="Task_6" name="调查和确认差异【财务审核岗】" flowable:candidateGroups="FIN_AUDIT" />
    <bpmn:userTask id="Task_7" name="接收对账反馈" flowable:assignee="${approver}" />
    <bpmn:userTask id="Task_8" name="审核确认差异【财务审核岗】" flowable:candidateGroups="FIN_AUDIT" />
    <bpmn:endEvent id="EndEvent_1" name="结束" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_3" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_4" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_5" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_6" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_7" targetRef="Task_8" />
    <bpmn:sequenceFlow id="Flow_end" sourceRef="Task_8" targetRef="EndEvent_1" />
  </bpmn:process>
