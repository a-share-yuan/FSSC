<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_TR_PLAN_ADJUST" targetNamespace="http://fssc">
  <bpmn:process id="TR_PLAN_ADJUST" name="资金计划调整审批流程" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="开始" />
    <bpmn:userTask id="Task_2" name="录入调整资金计划与调整依据（作业池）【资金岗】" flowable:candidateGroups="FUND_STAFF" />
    <bpmn:userTask id="Task_3" name="基地财务经理审核计划调整【基地财务经理】" flowable:candidateGroups="BASE_FIN_MANAGER" />
    <bpmn:userTask id="Task_6" name="板块财务经理审批计划调整【板块财务经理】" flowable:candidateGroups="PLATE_FIN_MANAGER" />
    <bpmn:exclusiveGateway id="Gw_7" default="Flow_7_def" />
    <bpmn:userTask id="Task_7" name="财务总监审批计划调整（总额超 500 万）【财务总监】" flowable:candidateGroups="CFO" />
    <bpmn:endEvent id="EndEvent_1" name="结束" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_3" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_6" targetRef="Gw_7" />
    <bpmn:sequenceFlow id="Flow_7_cond" name="金额&gt;5000000" sourceRef="Gw_7" targetRef="Task_7"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount > 5000000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7_def" name="金额不足/其他" sourceRef="Gw_7" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_7in" sourceRef="Task_7" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="TR_PLAN_ADJUST">
<bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1"><dc:Bounds x="120" y="102" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2"><dc:Bounds x="216" y="80" width="130" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3"><dc:Bounds x="406" y="80" width="130" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Task_6_di" bpmnElement="Task_6"><dc:Bounds x="596" y="80" width="130" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Gw_7_di" bpmnElement="Gw_7"><dc:Bounds x="786" y="102" width="40" height="40" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Task_7_di" bpmnElement="Task_7"><dc:Bounds x="886" y="80" width="130" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1"><dc:Bounds x="1076" y="102" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="156" y="120" /><di:waypoint x="216" y="120" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="346" y="120" /><di:waypoint x="406" y="120" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="536" y="120" /><di:waypoint x="596" y="120" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="726" y="120" /><di:waypoint x="786" y="122" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_7_cond_di" bpmnElement="Flow_7_cond"><di:waypoint x="826" y="122" /><di:waypoint x="886" y="120" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_7_def_di" bpmnElement="Flow_7_def"><di:waypoint x="806" y="142" /><di:waypoint x="806" y="230" /><di:waypoint x="1094" y="230" /><di:waypoint x="1094" y="138" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_7in_di" bpmnElement="Flow_7in"><di:waypoint x="1016" y="120" /><di:waypoint x="1076" y="120" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
