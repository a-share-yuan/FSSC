  <bpmn:process id="FA_ADD" name="资产新增审批流程（含在建转固档）" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="开始" />
    <bpmn:exclusiveGateway id="GW_FAADD" name="来源分档" default="Flow_in_FK_1" />
    <bpmn:sequenceFlow id="Flow_start_gw" sourceRef="StartEvent_1" targetRef="GW_FAADD" />
    <bpmn:userTask id="FK_1" name="验收登记【资产管理员】" flowable:candidateGroups="FA_ASSET_ADMIN" />
    <bpmn:sequenceFlow id="Flow_in_FK_1" sourceRef="GW_FAADD" targetRef="FK_1" />
    <bpmn:userTask id="FK_2" name="使用部门确认【部门经理】" flowable:candidateGroups="DEPT_MANAGER" />
    <bpmn:sequenceFlow id="Flow_in_FK_2" sourceRef="FK_1" targetRef="FK_2" />
    <bpmn:userTask id="FK_3" name="资产账套过账【资产核算岗】" flowable:candidateGroups="FA_ASSET_ACCOUNT" />
    <bpmn:sequenceFlow id="Flow_in_FK_3" sourceRef="FK_2" targetRef="FK_3" />
    <bpmn:exclusiveGateway id="GW_FAADD_AMT" name="金额授权" default="Flow_end" />
    <bpmn:sequenceFlow id="Flow_in_GW_FAADD_AMT" sourceRef="FK_3" targetRef="GW_FAADD_AMT" />
    <bpmn:userTask id="FK_6" name="总裁审批【总裁】" flowable:candidateGroups="PRESIDENT" />
    <bpmn:sequenceFlow id="Flow_GW_FAADD_AMT_FK_6" sourceRef="GW_FAADD_AMT" targetRef="FK_6"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt; 5000000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:userTask id="FK_5" name="财务总监审批【财务总监】" flowable:candidateGroups="CFO" />
    <bpmn:sequenceFlow id="Flow_GW_FAADD_AMT_FK_5" sourceRef="GW_FAADD_AMT" targetRef="FK_5"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt; 500000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:userTask id="FK_4" name="财务经理审批【财务经理】" flowable:candidateGroups="FIN_MANAGER" />
    <bpmn:sequenceFlow id="Flow_GW_FAADD_AMT_FK_4" sourceRef="GW_FAADD_AMT" targetRef="FK_4"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt; 100000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_back_FK_6" sourceRef="FK_6" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_back_FK_5" sourceRef="FK_5" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_back_FK_4" sourceRef="FK_4" targetRef="EndEvent_1" />
    <bpmn:userTask id="FC_1" name="转固单据扫描【财务扫描岗】" flowable:candidateGroups="SCAN_STAFF" />
    <bpmn:sequenceFlow id="Flow_GW_FAADD_FC_1" sourceRef="GW_FAADD" targetRef="FC_1" name="在建转固档"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${billType == 'FA_CIP_TO_ASSET'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:userTask id="FC_2" name="转固财务审核【财务审核岗】" flowable:candidateGroups="FIN_AUDIT" />
    <bpmn:sequenceFlow id="Flow_FC_2" sourceRef="FC_1" targetRef="FC_2" />
    <bpmn:userTask id="FC_3" name="资产账套过户【资产核算岗】" flowable:candidateGroups="FA_ASSET_ACCOUNT" />
    <bpmn:sequenceFlow id="Flow_FC_3" sourceRef="FC_2" targetRef="FC_3" />
    <bpmn:userTask id="FC_4" name="转固制证确认【总账会计】" flowable:candidateGroups="FIN_GL" />
    <bpmn:sequenceFlow id="Flow_FC_4" sourceRef="FC_3" targetRef="FC_4" />
    <bpmn:sequenceFlow id="Flow_sgjoin_FC_4" sourceRef="FC_4" targetRef="EndEvent_1" />
    <bpmn:endEvent id="EndEvent_1" name="结束" />
    <bpmn:sequenceFlow id="Flow_end" sourceRef="GW_FAADD_AMT" targetRef="EndEvent_1" />
  </bpmn:process>
