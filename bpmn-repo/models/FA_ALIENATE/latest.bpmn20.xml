<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FA_ALIENATE" targetNamespace="http://fssc">
  <bpmn:process id="FA_ALIENATE" name="资产处置审批流程(对外销售)" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="开始" />
    <bpmn:userTask id="Task_1" name="采购招标三方比价与处置销售协议签订（作业池）【采购经理】" flowable:candidateGroups="PURCHASE_MANAGER" />
    <bpmn:userTask id="Task_2" name="业务部门审核处置【部门经理】" flowable:candidateGroups="DEPT_MANAGER" />
    <bpmn:userTask id="Task_4" name="财务经理审批【财务经理】" flowable:candidateGroups="FIN_MANAGER" />
    <bpmn:exclusiveGateway id="Gw_3" default="Flow_3_def" />
    <bpmn:userTask id="Task_3" name="基地总经理审批（超 20 万）【基地总经理】" flowable:candidateGroups="BASE_GM" />
    <bpmn:exclusiveGateway id="Gw_4" default="Flow_4_def" />
    <bpmn:userTask id="Task_6" name="财务总监审批（超 50 万）【财务总监】" flowable:candidateGroups="CFO" />
    <bpmn:exclusiveGateway id="Gw_5" default="Flow_5_def" />
    <bpmn:userTask id="Task_7" name="董办/董会上会决议（超 200 万）【董办/总裁办公会】" flowable:candidateGroups="BOARD_OFFICE" />
    <bpmn:endEvent id="EndEvent_1" name="结束" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_2" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_4" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="Flow_3_cond" name="金额&gt;200000" sourceRef="Gw_3" targetRef="Task_3"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount > 200000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3_def" name="金额不足/其他" sourceRef="Gw_3" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_3in" sourceRef="Task_3" targetRef="Gw_4" />
    <bpmn:sequenceFlow id="Flow_4_cond" name="金额&gt;500000" sourceRef="Gw_4" targetRef="Task_6"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount > 500000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4_def" name="金额不足/其他" sourceRef="Gw_4" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_4in" sourceRef="Task_6" targetRef="Gw_5" />
    <bpmn:sequenceFlow id="Flow_5_cond" name="金额&gt;2000000" sourceRef="Gw_5" targetRef="Task_7"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount > 2000000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5_def" name="金额不足/其他" sourceRef="Gw_5" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_end" sourceRef="Task_7" targetRef="EndEvent_1" />
  </bpmn:process>
