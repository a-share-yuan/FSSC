    <bpmn:sequenceFlow id="Flow_3in" sourceRef="Task_3" targetRef="Gw_4" />
    <bpmn:sequenceFlow id="Flow_4_cond" name="金额&gt;1000000" sourceRef="Gw_4" targetRef="Task_4"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount > 1000000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4_def" name="金额不足/其他" sourceRef="Gw_4" targetRef="Gw_5" />
    <bpmn:sequenceFlow id="Flow_4in" sourceRef="Task_4" targetRef="Gw_5" />
    <bpmn:sequenceFlow id="Flow_5_cond" name="金额&gt;5000000" sourceRef="Gw_5" targetRef="Task_5"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount > 5000000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5_def" name="金额不足/其他" sourceRef="Gw_5" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_5in" sourceRef="Task_5" targetRef="EndEvent_1" />
