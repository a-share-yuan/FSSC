    <bpmn:startEvent id="StartEvent_1" name="开始" />
    <bpmn:parallelGateway id="Pg_2" />
    <bpmn:userTask id="Task_2_0" name="项目经理会审付款计划与项目预算【项目经理/费用承担部门负责人】" flowable:candidateGroups="PROJECT_MANAGER" />
    <bpmn:userTask id="Task_2_1" name="基地财务经理会审资金与预算占用【基地财务经理】" flowable:candidateGroups="BASE_FIN_MANAGER" />
    <bpmn:userTask id="Task_2_2" name="资金支付岗会审支付可行性【资金支付岗】" flowable:candidateGroups="FUND_PAY_STAFF" />
    <bpmn:userTask id="Task_2_3" name="板块财务经理会审板块资金平衡【板块财务经理】" flowable:candidateGroups="PLATE_FIN_MANAGER" />
    <bpmn:parallelGateway id="Jg_2" />
    <bpmn:userTask id="Task_3" name="采购总监汇总审批会审意见【采购总监】" flowable:candidateGroups="PURCHASE_DIRECTOR" />
    <bpmn:exclusiveGateway id="Gw_4" default="Flow_4_def" />
    <bpmn:userTask id="Task_4" name="财务总监审批付款计划（超 100 万）【财务总监】" flowable:candidateGroups="CFO" />
    <bpmn:exclusiveGateway id="Gw_5" default="Flow_5_def" />
    <bpmn:userTask id="Task_5" name="总裁审批付款计划（超 500 万）【总裁】" flowable:candidateGroups="PRESIDENT" />
    <bpmn:endEvent id="EndEvent_1" name="结束" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Pg_2" />
    <bpmn:sequenceFlow id="Flow_2a" sourceRef="Pg_2" targetRef="Task_2_0" />
