  <bpmn:process id="CLAIM_G1" name="招待费付款审批流程" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="开始" />
    <bpmn:userTask id="Task_2" name="部门经理审核业务真实性【部门经理】" flowable:candidateGroups="DEPT_MANAGER" />
    <bpmn:userTask id="Task_3" name="共享审核人均标准及预制凭证【共享会计】" flowable:candidateGroups="FSSC_AUDITOR" />
    <bpmn:userTask id="Task_4" name="总监级授权审批【中心/总监级审批档】" flowable:candidateGroups="CENTER_APPROVER" />
    <bpmn:exclusiveGateway id="Gw_2" name="大额升级判定" default="Flow_9" />
    <bpmn:userTask id="Task_5" name="高管决策审批【高管决策审批档】" flowable:candidateGroups="EXEC_APPROVER" />
    <bpmn:userTask id="Task_7" name="审核预制凭证【总账会计】" flowable:candidateGroups="FIN_GL" />
    <bpmn:endEvent id="EndEvent_1" name="结束" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_3" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_4" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="Flow_8" name="金额&gt;1万" sourceRef="Gw_2" targetRef="Task_5"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount > 10000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" name="金额不足/其他" sourceRef="Gw_2" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_5" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_7" targetRef="EndEvent_1" />
  </bpmn:process>
