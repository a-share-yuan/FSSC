<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_CLAIM_G1" targetNamespace="http://fssc">
  <bpmn:process id="CLAIM_G1" name="招待费付款审批流程" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="开始" />
    <bpmn:exclusiveGateway id="Gw_1" name="招待费判定" default="Flow_3" />
    <bpmn:userTask id="Task_1" name="提交招待费付款申请【普通员工】" flowable:candidateGroups="COMMON_EMP" />
    <bpmn:userTask id="Task_2" name="部门经理审核【部门经理—核业务真实性】" flowable:candidateGroups="DEPT_MANAGER" />
    <bpmn:userTask id="Task_3" name="财务共享审核【共享会计—人均标准/真实性】" flowable:candidateGroups="FSSC_AUDITOR" />
    <bpmn:userTask id="Task_4" name="财务总监审核【财务总监】" flowable:candidateGroups="CENTER_APPROVER" />
    <bpmn:exclusiveGateway id="Gw_2" name="大额升级判定" default="Flow_9" />
    <bpmn:userTask id="Task_5" name="执行总裁审批【执行总裁—大额升级】" flowable:candidateGroups="EXEC_APPROVER" />
    <bpmn:userTask id="Task_6" name="审核预制凭证【共享会计】" flowable:candidateGroups="FSSC_AUDITOR" />
    <bpmn:userTask id="Task_7" name="生成凭证【总账会计】" flowable:candidateGroups="FIN_GL" />
    <bpmn:endEvent id="EndEvent_1" name="结束" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Gw_1" />
    <bpmn:sequenceFlow id="Flow_2" name="招待费" sourceRef="Gw_1" targetRef="Task_1"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${expenseType == 'ENTERTAIN'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" name="非招待费" sourceRef="Gw_1" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_3" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_4" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="Flow_8" name="金额&gt;10000" sourceRef="Gw_2" targetRef="Task_5"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt; 10000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" name="金额不足/其他" sourceRef="Gw_2" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_5" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_6" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_7" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_CLAIM_G1">
    <bpmndi:BPMNPlane id="BPMNPlane_CLAIM_G1" bpmnElement="CLAIM_G1">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1"><dc:Bounds x="120" y="102" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_1_di" bpmnElement="Gw_1"><dc:Bounds x="200" y="102" width="40" height="40" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1"><dc:Bounds x="290" y="80" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2"><dc:Bounds x="480" y="80" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3"><dc:Bounds x="670" y="80" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_4_di" bpmnElement="Task_4"><dc:Bounds x="880" y="80" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_2_di" bpmnElement="Gw_2"><dc:Bounds x="1070" y="102" width="40" height="40" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_5_di" bpmnElement="Task_5"><dc:Bounds x="1160" y="80" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_6_di" bpmnElement="Task_6"><dc:Bounds x="1390" y="80" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_7_di" bpmnElement="Task_7"><dc:Bounds x="1580" y="80" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1"><dc:Bounds x="1770" y="102" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="156" y="120" /><di:waypoint x="200" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="240" y="120" /><di:waypoint x="290" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="220" y="142" /><di:waypoint x="220" y="220" /><di:waypoint x="1788" y="220" /><di:waypoint x="1788" y="142" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="420" y="120" /><di:waypoint x="480" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="610" y="120" /><di:waypoint x="670" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="830" y="120" /><di:waypoint x="880" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="1010" y="120" /><di:waypoint x="1070" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="1110" y="120" /><di:waypoint x="1160" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="1090" y="142" /><di:waypoint x="1090" y="220" /><di:waypoint x="1455" y="220" /><di:waypoint x="1455" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1320" y="120" /><di:waypoint x="1390" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1520" y="120" /><di:waypoint x="1580" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1710" y="120" /><di:waypoint x="1770" y="120" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>