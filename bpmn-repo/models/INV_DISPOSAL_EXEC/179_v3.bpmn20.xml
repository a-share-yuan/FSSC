  <bpmn:process id="INV_DISPOSAL_EXEC" name="存货处置-处置执行与账务流程" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="开始" />
    <bpmn:userTask id="Task_2" name="处置协议、收款与发票影像齐套（作业池）【财务扫描岗】" flowable:candidateGroups="SCAN_STAFF" />
    <bpmn:parallelGateway id="Fk_3" />
    <bpmn:userTask id="Task_3" name="仓库确认处置物资已出库【仓库管理员】" flowable:candidateGroups="WH_KEEPER" />
    <bpmn:userTask id="Task_4" name="归口部门审核处置方式合规【部门经理】" flowable:candidateGroups="DEPT_MANAGER" />
    <bpmn:userTask id="Task_5" name="基地财务经理审核处置收入与损益【基地财务经理】" flowable:candidateGroups="BASE_FIN_MANAGER" />
    <bpmn:parallelGateway id="Jk_3" />
    <bpmn:userTask id="Task_7" name="财务审核岗审单（协议·收款·开票齐套）【财务审核岗】" flowable:candidateGroups="FIN_AUDIT" />
    <bpmn:exclusiveGateway id="Gw_8" default="Flow_8_def" />
    <bpmn:userTask id="Task_8" name="财务总监审批处置（超 50 万）【财务总监】" flowable:candidateGroups="CFO" />
    <bpmn:endEvent id="EndEvent_1" name="结束" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_2" targetRef="Fk_3" />
    <bpmn:sequenceFlow id="Flow_3a" sourceRef="Fk_3" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_3b" sourceRef="Fk_3" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_3c" sourceRef="Fk_3" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_3x" sourceRef="Task_3" targetRef="Jk_3" />
    <bpmn:sequenceFlow id="Flow_3y" sourceRef="Task_4" targetRef="Jk_3" />
    <bpmn:sequenceFlow id="Flow_3z" sourceRef="Task_5" targetRef="Jk_3" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Jk_3" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_7in" sourceRef="Task_7" targetRef="Gw_8" />
    <bpmn:sequenceFlow id="Flow_8_cond" name="金额&gt;500000" sourceRef="Gw_8" targetRef="Task_8"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount > 500000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8_def" name="金额不足/其他" sourceRef="Gw_8" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_8in" sourceRef="Task_8" targetRef="EndEvent_1" />
  </bpmn:process>
