    <bpmn:userTask id="Task_4" name="部门经理审核【部门经理】" flowable:candidateGroups="DEPT_MANAGER" />
    <bpmn:userTask id="Task_7" name="项目经理/费用承担部门审核【项目经理/费用承担部门负责人】" flowable:candidateGroups="PROJECT_MANAGER" />
    <bpmn:userTask id="Task_3" name="审核单据及付款申请【财务审核岗】" flowable:candidateGroups="FIN_AUDIT" />
    <bpmn:exclusiveGateway id="Gw_9" name="金额授权" default="Flow_9_def" />
    <bpmn:userTask id="Task_9" name="基地总经理审核【基地总经理】" flowable:candidateGroups="BASE_GM" />
    <bpmn:exclusiveGateway id="Gw_10" default="Flow_10_def" />
    <bpmn:userTask id="Task_10" name="板块财务经理审核【板块财务经理】" flowable:candidateGroups="PLATE_FIN_MANAGER" />
    <bpmn:exclusiveGateway id="Gw_11" default="Flow_11_def" />
    <bpmn:userTask id="Task_11" name="板块分管领导审核【板块分管领导】" flowable:candidateGroups="PLATE_DIV_LEADER" />
    <bpmn:exclusiveGateway id="Gw_13" default="Flow_13_def" />
    <bpmn:userTask id="Task_12" name="总裁审批【总裁】" flowable:candidateGroups="PRESIDENT" />
    <bpmn:endEvent id="EndEvent_1" name="结束" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_2" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_4" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_7" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_3" targetRef="Gw_9" />
    <bpmn:sequenceFlow id="Flow_9_cond" name="金额&gt;5万" sourceRef="Gw_9" targetRef="Task_9"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount > 50000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9_def" name="金额不足/其他" sourceRef="Gw_9" targetRef="Gw_10" />
    <bpmn:sequenceFlow id="Flow_9_in" sourceRef="Task_9" targetRef="Gw_10" />
    <bpmn:sequenceFlow id="Flow_10_cond" name="金额&gt;20万" sourceRef="Gw_10" targetRef="Task_10"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount > 200000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10_def" name="金额不足/其他" sourceRef="Gw_10" targetRef="Gw_11" />
    <bpmn:sequenceFlow id="Flow_10_in" sourceRef="Task_10" targetRef="Gw_11" />
    <bpmn:sequenceFlow id="Flow_11_cond" name="金额&gt;50万" sourceRef="Gw_11" targetRef="Task_11"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount > 500000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11_def" name="金额不足/其他" sourceRef="Gw_11" targetRef="Gw_13" />
    <bpmn:sequenceFlow id="Flow_11_in" sourceRef="Task_11" targetRef="Gw_13" />
    <bpmn:sequenceFlow id="Flow_13_cond" name="金额&gt;500万" sourceRef="Gw_13" targetRef="Task_12"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount > 5000000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13_def" name="金额不足/其他" sourceRef="Gw_13" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_end" sourceRef="Task_12" targetRef="EndEvent_1" />
