<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FM_DESTROY" targetNamespace="http://fssc">
  <bpmn:process id="FM_DESTROY" name="会计凭证销毁审批流程" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="开始" />
    <bpmn:userTask id="Task_3" name="共享主管审核账面与档案一致性【共享主管】" flowable:assignee="${assignee}" flowable:candidateGroups="FSSC_SUPERVISOR">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${Task_3_assignees}" flowable:elementVariable="assignee">
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">${nrOfCompletedInstances == nrOfInstances}</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>
    <bpmn:userTask id="Task_2" name="内审经理监销复核销毁清单与到期合规【内审经理】" flowable:candidateGroups="INTERNAL_AUDITOR" />
    <bpmn:userTask id="Task_5" name="财务总监审批档案销毁【财务总监】" flowable:candidateGroups="CFO" />
    <bpmn:userTask id="Task_6" name="总裁审批档案销毁【总裁】" flowable:candidateGroups="PRESIDENT" />
    <bpmn:userTask id="Task_7" name="取出清点与销毁执行并登记监销记录（作业池）【档案管理员】" flowable:candidateGroups="FM_ARCHIVIST" />
    <bpmn:endEvent id="EndEvent_1" name="结束" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_3" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_2" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_5" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_6" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_end" sourceRef="Task_7" targetRef="EndEvent_1" />
  </bpmn:process>
