<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GL_SALARY_PAY" targetNamespace="http://fssc">
  <bpmn:process id="GL_SALARY_PAY" name="薪酬核算（工资发放）流程" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="开始" />
    <bpmn:userTask id="Task_1" name="工资发放数据计算与网银明细准备（作业池）【总账会计】" flowable:candidateGroups="FIN_GL" />
    <bpmn:userTask id="Task_3" name="审核工资发放【财务审核岗】" flowable:candidateGroups="FIN_AUDIT" />
    <bpmn:exclusiveGateway id="Gw_3" default="Flow_3_def" />
    <bpmn:userTask id="Task_13" name="财务总监审批（超 50 万）【财务总监】" flowable:candidateGroups="CFO" />
    <bpmn:userTask id="Task_4" name="网银录入发放明细【资金支付岗】" flowable:candidateGroups="FUND_PAY_STAFF" />
    <bpmn:userTask id="Task_5" name="网银付款审核【资金岗】" flowable:candidateGroups="FUND_STAFF" />
    <bpmn:userTask id="Task_9" name="复核发放记账单【总账会计】" flowable:candidateGroups="FIN_GL" />
    <bpmn:endEvent id="EndEvent_1" name="结束" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_3_in" sourceRef="Task_3" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="Flow_3_cond" name="金额&gt;500000" sourceRef="Gw_3" targetRef="Task_13"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount > 500000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3_def" name="金额不足/其他" sourceRef="Gw_3" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_13" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_4" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_5" targetRef="Task_9" />
    <bpmn:sequenceFlow id="Flow_end" sourceRef="Task_9" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="GL_SALARY_PAY">
<bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1"><dc:Bounds x="120" y="102" width="36" height="36" /></bpmndi:BPMNShape>
