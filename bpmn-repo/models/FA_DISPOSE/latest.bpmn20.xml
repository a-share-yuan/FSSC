<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FA_DISPOSE" targetNamespace="http://fssc">
  <bpmn:process id="FA_DISPOSE" name="资产处置审批流程（报废/对外销售档）" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="开始" />
    <bpmn:exclusiveGateway id="GW_FAD" name="处置方式分档" default="Flow_in_FD_1" />
    <bpmn:sequenceFlow id="Flow_start_gw" sourceRef="StartEvent_1" targetRef="GW_FAD" />
    <bpmn:userTask id="FD_1" name="处置申请登记【资产管理员】" flowable:candidateGroups="FA_ASSET_ADMIN" />
    <bpmn:sequenceFlow id="Flow_in_FD_1" sourceRef="GW_FAD" targetRef="FD_1" />
    <bpmn:userTask id="FD_2" name="内审复核【内审专员】" flowable:candidateGroups="INTERNAL_AUDITOR" />
    <bpmn:sequenceFlow id="Flow_in_FD_2" sourceRef="FD_1" targetRef="FD_2" />
    <bpmn:exclusiveGateway id="GW_FAD_AMT" name="金额授权" default="Flow_in_FD_3" />
    <bpmn:sequenceFlow id="Flow_in_GW_FAD_AMT" sourceRef="FD_2" targetRef="GW_FAD_AMT" />
    <bpmn:userTask id="FD_5" name="总裁审批【总裁】" flowable:candidateGroups="PRESIDENT" />
    <bpmn:sequenceFlow id="Flow_GW_FAD_AMT_FD_5" sourceRef="GW_FAD_AMT" targetRef="FD_5"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt; 5000000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:userTask id="FD_4" name="财务总监审批【财务总监】" flowable:candidateGroups="CFO" />
    <bpmn:sequenceFlow id="Flow_GW_FAD_AMT_FD_4" sourceRef="GW_FAD_AMT" targetRef="FD_4"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt; 500000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:userTask id="FD_3" name="账务清理确认【总账会计】" flowable:candidateGroups="FIN_GL" />
    <bpmn:sequenceFlow id="Flow_in_FD_3" sourceRef="GW_FAD_AMT" targetRef="FD_3" />
    <bpmn:sequenceFlow id="Flow_back_FD_5" sourceRef="FD_5" targetRef="FD_3" />
    <bpmn:sequenceFlow id="Flow_back_FD_4" sourceRef="FD_4" targetRef="FD_3" />
    <bpmn:userTask id="FDA_1" name="售价与受让方核对【采购经理】" flowable:candidateGroups="PURCHASE_MANAGER" />
    <bpmn:sequenceFlow id="Flow_GW_FAD_FDA_1" sourceRef="GW_FAD" targetRef="FDA_1" name="对外销售档"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${billType == 'FA_ALIENATE'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:userTask id="FDA_2" name="受让核对复核【内审专员】" flowable:candidateGroups="INTERNAL_AUDITOR" />
    <bpmn:sequenceFlow id="Flow_FDA_2" sourceRef="FDA_1" targetRef="FDA_2" />
    <bpmn:sequenceFlow id="Flow_sgjoin_FDA_2" sourceRef="FDA_2" targetRef="FD_3" />
    <bpmn:endEvent id="EndEvent_1" name="结束" />
    <bpmn:sequenceFlow id="Flow_end" sourceRef="FD_3" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="FA_DISPOSE">
<bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1"><dc:Bounds x="120" y="102" width="36" height="36" /></bpmndi:BPMNShape>
