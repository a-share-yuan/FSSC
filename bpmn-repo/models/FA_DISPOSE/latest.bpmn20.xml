<bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1"><dc:Bounds x="996" y="102" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="Flow_start_gw_di" bpmnElement="Flow_start_gw"><di:waypoint x="138" y="120" /><di:waypoint x="236" y="122" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_in_FD_1_di" bpmnElement="Flow_in_FD_1"><di:waypoint x="236" y="122" /><di:waypoint x="381" y="120" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_in_FD_2_di" bpmnElement="Flow_in_FD_2"><di:waypoint x="381" y="120" /><di:waypoint x="571" y="120" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_in_GW_FAD_AMT_di" bpmnElement="Flow_in_GW_FAD_AMT"><di:waypoint x="571" y="120" /><di:waypoint x="716" y="122" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_GW_FAD_AMT_FD_5_di" bpmnElement="Flow_GW_FAD_AMT_FD_5"><di:waypoint x="716" y="122" /><di:waypoint x="716" y="280" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_GW_FAD_AMT_FD_4_di" bpmnElement="Flow_GW_FAD_AMT_FD_4"><di:waypoint x="716" y="122" /><di:waypoint x="716" y="370" /></bpmndi:BPMNEdge>
