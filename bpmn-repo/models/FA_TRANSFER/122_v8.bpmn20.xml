  <bpmn:process id="FA_TRANSFER" name="资产调拨审批流程（同公司/跨法人档）" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="开始" />
    <bpmn:exclusiveGateway id="GW_FATR" name="调拨范围分档" default="Flow_in_FT_1" />
    <bpmn:sequenceFlow id="Flow_start_gw" sourceRef="StartEvent_1" targetRef="GW_FATR" />
    <bpmn:userTask id="FT_1" name="调拨申请登记【财务扫描岗】" flowable:candidateGroups="SCAN_STAFF" />
    <bpmn:sequenceFlow id="Flow_in_FT_1" sourceRef="GW_FATR" targetRef="FT_1" />
    <bpmn:userTask id="FT_2" name="转出部门确认【部门经理】" flowable:candidateGroups="DEPT_MANAGER" />
    <bpmn:sequenceFlow id="Flow_in_FT_2" sourceRef="FT_1" targetRef="FT_2" />
    <bpmn:userTask id="FT_3" name="资产账套核对【资产核算岗】" flowable:candidateGroups="FA_ASSET_ACCOUNT" />
    <bpmn:sequenceFlow id="Flow_in_FT_3" sourceRef="FT_2" targetRef="FT_3" />
    <bpmn:userTask id="FT_4" name="台账过户【资产核算岗】" flowable:candidateGroups="FA_ASSET_ACCOUNT" />
    <bpmn:sequenceFlow id="Flow_in_FT_4" sourceRef="FT_3" targetRef="FT_4" />
    <bpmn:userTask id="FXT_1" name="转出公司确认【部门经理】" flowable:candidateGroups="DEPT_MANAGER" />
    <bpmn:sequenceFlow id="Flow_GW_FATR_FXT_1" sourceRef="GW_FATR" targetRef="FXT_1" name="跨法人档"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${billType == 'FA_TRANSFER_CROSS'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:userTask id="FXT_2" name="受让公司总经理审批【总经理】" flowable:candidateGroups="GM" />
    <bpmn:sequenceFlow id="Flow_FXT_2" sourceRef="FXT_1" targetRef="FXT_2" />
    <bpmn:userTask id="FXT_3" name="跨法人账务处理【总账会计】" flowable:candidateGroups="FIN_GL" />
    <bpmn:sequenceFlow id="Flow_FXT_3" sourceRef="FXT_2" targetRef="FXT_3" />
    <bpmn:sequenceFlow id="Flow_sgjoin_FXT_3" sourceRef="FXT_3" targetRef="FT_4" />
    <bpmn:endEvent id="EndEvent_1" name="结束" />
    <bpmn:sequenceFlow id="Flow_end" sourceRef="FT_4" targetRef="EndEvent_1" />
  </bpmn:process>
