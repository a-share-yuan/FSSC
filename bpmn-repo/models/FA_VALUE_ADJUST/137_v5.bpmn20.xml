<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FA_VALUE_ADJUST" targetNamespace="http://fssc">
  <bpmn:process id="FA_VALUE_ADJUST" name="资产原值调整审批流程" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="开始" />
    <bpmn:userTask id="Task_2" name="业务部门经理审批原值调整【部门经理】" flowable:candidateGroups="DEPT_MANAGER" />
    <bpmn:userTask id="Task_4" name="基地财务经理审核【基地财务经理】" flowable:candidateGroups="BASE_FIN_MANAGER" />
    <bpmn:exclusiveGateway id="Gw_3" default="Flow_31_def" />
    <bpmn:userTask id="Task_3" name="基地总经理审批（调整超 5 万）【基地总经理】" flowable:candidateGroups="BASE_GM" />
    <bpmn:exclusiveGateway id="Gw_5" default="Flow_5_def" />
    <bpmn:userTask id="Task_5" name="财务总监审批（调整超 50 万）【财务总监】" flowable:candidateGroups="CFO" />
    <bpmn:userTask id="Task_6" name="稽核岗复核原值调整【财务审核岗】" flowable:candidateGroups="FIN_AUDIT" />
    <bpmn:userTask id="Task_7" name="调整生效后维护资产卡片并制作调整凭证（作业池）【资产核算岗】" flowable:candidateGroups="FA_ASSET_ACCOUNT" />
    <bpmn:endEvent id="EndEvent_1" name="结束" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_2" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_4" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="Flow_31_cond" name="金额&gt;50000" sourceRef="Gw_3" targetRef="Task_3"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount > 50000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_31_def" name="金额不足/其他" sourceRef="Gw_3" targetRef="Gw_5" />
    <bpmn:sequenceFlow id="Flow_3in" sourceRef="Task_3" targetRef="Gw_5" />
    <bpmn:sequenceFlow id="Flow_5_cond" name="金额&gt;500000" sourceRef="Gw_5" targetRef="Task_5"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount > 500000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5_def" name="金额不足/其他" sourceRef="Gw_5" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_5in" sourceRef="Task_5" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_6" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_end" sourceRef="Task_7" targetRef="EndEvent_1" />
  </bpmn:process>
