  <bpmn:process id="FA_VALUE_ADJUST" name="资产价值调整审批流程（原值/减值/跌价档）" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="开始" />
    <bpmn:userTask id="FV_1" name="调整底稿【资产管理员】" flowable:candidateGroups="FA_ASSET_ADMIN" />
    <bpmn:sequenceFlow id="Flow_in_FV_1" sourceRef="StartEvent_1" targetRef="FV_1" />
    <bpmn:userTask id="FV_2" name="使用部门确认【部门经理】" flowable:candidateGroups="DEPT_MANAGER" />
    <bpmn:sequenceFlow id="Flow_in_FV_2" sourceRef="FV_1" targetRef="FV_2" />
    <bpmn:userTask id="FV_3" name="财务审核【财务审核岗】" flowable:candidateGroups="FIN_AUDIT" />
    <bpmn:sequenceFlow id="Flow_in_FV_3" sourceRef="FV_2" targetRef="FV_3" />
    <bpmn:exclusiveGateway id="GW_FAV_AMT" name="金额授权" default="Flow_in_FV_5" />
    <bpmn:sequenceFlow id="Flow_in_GW_FAV_AMT" sourceRef="FV_3" targetRef="GW_FAV_AMT" />
    <bpmn:userTask id="FV_4" name="财务总监审批【财务总监】" flowable:candidateGroups="CFO" />
    <bpmn:sequenceFlow id="Flow_GW_FAV_AMT_FV_4" sourceRef="GW_FAV_AMT" targetRef="FV_4"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt; 500000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:userTask id="FV_5" name="账务生效确认【资产核算岗】" flowable:candidateGroups="FA_ASSET_ACCOUNT" />
    <bpmn:sequenceFlow id="Flow_in_FV_5" sourceRef="GW_FAV_AMT" targetRef="FV_5" />
    <bpmn:sequenceFlow id="Flow_back_FV_4" sourceRef="FV_4" targetRef="FV_5" />
    <bpmn:endEvent id="EndEvent_1" name="结束" />
    <bpmn:sequenceFlow id="Flow_end" sourceRef="FV_5" targetRef="EndEvent_1" />
  </bpmn:process>
