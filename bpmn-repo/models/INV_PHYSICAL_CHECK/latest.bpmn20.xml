    <bpmn:startEvent id="StartEvent_1" name="开始" />
    <bpmn:userTask id="Task_2" name="业务部门经理审批盘点差异明细表【部门经理】" flowable:candidateGroups="DEPT_MANAGER" />
    <bpmn:userTask id="Task_3" name="基地财务经理审批盘点差异【基地财务经理】" flowable:candidateGroups="BASE_FIN_MANAGER" />
    <bpmn:exclusiveGateway id="Gw_4" default="Flow_4_def" />
    <bpmn:userTask id="Task_4" name="基地总经理审批差异（超 20 万）【基地总经理】" flowable:candidateGroups="BASE_GM" />
    <bpmn:exclusiveGateway id="Gw_5" default="Flow_5_def" />
    <bpmn:userTask id="Task_5" name="财务总监审批差异（超 50 万）【财务总监】" flowable:candidateGroups="CFO" />
    <bpmn:parallelGateway id="Fk_6" />
    <bpmn:userTask id="Task_6" name="录入盘点差异数据并核对账存（作业池）【仓库管理员】" flowable:candidateGroups="WH_KEEPER" />
    <bpmn:userTask id="Task_7" name="稽核岗审核确认差异数据【财务审核岗】" flowable:candidateGroups="FIN_AUDIT" />
    <bpmn:parallelGateway id="Jk_6" />
    <bpmn:endEvent id="EndEvent_1" name="结束" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_3" targetRef="Gw_4" />
    <bpmn:sequenceFlow id="Flow_4_cond" name="金额&gt;200000" sourceRef="Gw_4" targetRef="Task_4"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount > 200000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4_def" name="金额不足/其他" sourceRef="Gw_4" targetRef="Gw_5" />
    <bpmn:sequenceFlow id="Flow_4in" sourceRef="Task_4" targetRef="Gw_5" />
    <bpmn:sequenceFlow id="Flow_5_cond" name="金额&gt;500000" sourceRef="Gw_5" targetRef="Task_5"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount > 500000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5_def" name="金额不足/其他" sourceRef="Gw_5" targetRef="Fk_6" />
    <bpmn:sequenceFlow id="Flow_5in" sourceRef="Task_5" targetRef="Fk_6" />
    <bpmn:sequenceFlow id="Flow_6a" sourceRef="Fk_6" targetRef="Task_6" />
