    <bpmn:userTask id="Task_3" name="基地财务经理审核【基地财务经理】" flowable:candidateGroups="BASE_FIN_MANAGER" />
    <bpmn:userTask id="Task_4" name="项目管理中心总监合规审核【项目管理中心总监】" flowable:candidateGroups="PM_CENTER_DIRECTOR" />
    <bpmn:exclusiveGateway id="Gw_5" default="Flow_5_def" />
    <bpmn:userTask id="Task_5" name="财务总监审批【财务总监】" flowable:candidateGroups="CFO" />
    <bpmn:userTask id="Task_6" name="共享审核报账单【共享会计】" flowable:candidateGroups="FSSC_AUDITOR" />
