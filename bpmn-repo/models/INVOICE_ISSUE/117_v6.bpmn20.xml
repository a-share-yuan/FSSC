    <bpmn:sequenceFlow id="Flow_5_def" name="金额不足/其他" sourceRef="Gw_5" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_5" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_end" sourceRef="Task_6" targetRef="EndEvent_1" />
