# ============================================================================
# FSSC 环境变量样例 —— 复制为 .env 后填写；.env 已被 .gitignore 忽略
# 规则：口令/密钥类【无默认值】，留空即启动失败（fail-fast），这是有意的。
# ============================================================================

# ---------- 必填 ----------
# 主库 fssc 与影像库 fssc_image 共用账号口令
FSSC_DB_PASSWORD=

# JWT 签名密钥：必须 ≥ 32 字节的强随机串。
# 生成方式： openssl rand -base64 48
#  多实例部署时所有实例必须注入同一个值，否则表现为"刚登录就被踢"。
FSSC_JWT_SECRET=

# 运行 profile：dev（本地/演示，OCR/银企走 mock，SQL 日志打开）| prod
SPRING_PROFILES_ACTIVE=dev

# ---------- 数据库连接（默认指向本机 3306，跨机部署才需要改）----------
# 主库（业务表 + Flowable ACT_* + 平台表）
FSSC_DB_MASTER_URL=jdbc:mysql://127.0.0.1:3306/fssc?useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_general_ci&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
# 影像分库（img_* / image_* / ocr_record 等 6 张表）
FSSC_DB_IMAGE_URL=jdbc:mysql://127.0.0.1:3306/fssc_image?useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_general_ci&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
FSSC_DB_USERNAME=root

# ---------- 服务端口 ----------
SERVER_PORT=8089
# 前端 vite dev/preview 反代目标（前端固定监听 8080）
FSSC_API_TARGET=http://127.0.0.1:8089

# ---------- 可选：分布式状态（多实例部署才需要）----------
# false = 进程内实现 + MySQL GET_LOCK 调度锁，单机行为，无需装 Redis
FSSC_REDIS_ENABLED=false
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379

# ---------- 可选：发票 / OCR 通道 ----------
# gateway=发票能力网关（独立服务，默认 8096）；mock=确定性模拟票面（离线演示用）；
# paddle=本地 PaddleOCR 微服务（默认 8087）；http=对接任意真引擎（只需配 sys_config）
FSSC_OCR_CHANNEL=mock
INVOICE_GATEWAY_ENABLED=false
INVOICE_GATEWAY_BASE_URL=http://127.0.0.1:8096
INVOICE_GATEWAY_API_KEY=

# ---------- 可选：银企直联 ----------
# mock=DefaultBankGateway（离线）；切换真实实现需自行扩展 bank/gateway
FSSC_BANK_GATEWAY=mock

# ---------- 可选：流程 BPMN 仓库目录 ----------
# 指向一个 git 工作副本，流程设计即获得 review/回溯能力；留默认值落在进程工作目录
FSSC_BPMN_REPO_DIR=./bpmn-repo

# ---------- 可选：接口文档端点 ----------
# 生产建议 false；true 时 /v3/api-docs 与 /swagger-ui.html 可访问
FSSC_OPENAPI_ENABLED=true

# ---------- 可选：消息与运维告警（留空即对应渠道自动禁用）----------
SPRING_MAIL_HOST=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
FSSC_NOTIFY_WECOM_WEBHOOK=
FSSC_NOTIFY_OPS_WEBHOOK=
FSSC_NOTIFY_OPS_MAIL_TO=
FSSC_NOTIFY_OPS_ALERT_ENABLED=true

# ---------- 可选：第三方回调（不接就留空，留空时回调一律拒绝）----------
FSSC_LINKU_CALLBACK_SECRET=

# ---------- 可选：登录图形验证码开关（本体未实现，仅预留开关，见 SECURITY.md）----------
FSSC_LOGIN_CAPTCHA_ENABLED=false

# ---------- 可选：自助注册（财务规范默认关闭，仅管理员邀请）----------
FSSC_SELF_REGISTRATION_ENABLED=false
