# ---- 构建产物 ----
target/
target_*/
**/target/
*.class
*.jar
!**/gradle/wrapper/*.jar
dist/
dist*/
build/
out/
node_modules/
__pycache__/
*.pyc

# ---- 运行时数据（含用户上传附件，绝不入库）----
# 用 **/ 前缀以覆盖任意目录深度（如 fssc/fssc-server/data/files/）
**/data/files/
**/upload/
/logs/
**/logs/
*.log
*.out
*.out.log
.run/

# ---- 数据库导出/备份（含真实业务数据，禁止提交）----
db/backup/
# 日后随手导出的整库 dump 默认不入仓（防 git add -A 带进来）；
# 作为建库入口的那一枚显式放行 —— 见 db/README.md
db/Dump*/
!db/Dump20261114/
!db/Dump20261114/**
*.dump
*_full_*.sql
*_rollback_*.jar
backup/

# ---- 本地配置与凭据 ----
.env
.env.*
!.env.example
application-local.yml
application-*.local.yml
*.p12
*.jks
settings-noproxy.xml

# ---- 编辑器/OS ----
.idea/
*.iml
.vscode/
.classpath
.project
.factorypath
.settings/
*.springBeans
.DS_Store
Thumbs.db
desktop.ini

# ---- 会话/临时施工产物 ----
.tmp*
_tmp*
_*backup/
temp_*
_*.log
_*.txt
_*.json
_*.sql

# Office/WPS 打开文档时写在同目录的所有者锁文件（曾被 `git add docs` 卷进发布面）
~$*
login_resp*.json
token.txt
nul
*.tmp
.scanner/
archive/graveyard*/
releases/

# ---- 施工目录（即使误拷也不入库）----
bpmn-repo/drafts/
output/

# ---- 施工残留 ----
*.prebak*
# 手册改名前后的本地备份目录（含旧版内容，不入库）
docs/_backup_*/
**/vsd_*.py
**/check_crud*.py
*tmp*_resp.json
