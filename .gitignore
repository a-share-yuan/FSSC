# ---- 运行时数据（含用户上传附件，绝不入库）----
# 用 **/ 前缀以覆盖任意目录深度（如 fssc/fssc-server/data/files/）
**/data/files/
**/upload/
/logs/
**/logs/
*.log
*.out
*.out.log
.run/

# ---- 数据库导出/备份（含真实业务数据，禁止提交）----
db/backup/
# 日后随手导出的整库 dump 默认不入仓（防 git add -A 带进来）；
# 作为建库入口的那一枚显式放行 —— 见 db/README.md
db/Dump*/
!db/Dump20261114/
!db/Dump20261114/**
*.dump
*_full_*.sql
*_rollback_*.jar
backup/

