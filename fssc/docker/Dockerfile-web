# FSSC 前端镜像：多阶段构建（Node 构建 → nginx 托管）
# 构建（上下文必须是 fssc/，与 docker/Dockerfile 同一上下文）：
#   docker build -t fssc-web:local -f docker/Dockerfile-web .
# Node 版本对齐 README「前置」表的 24.x（Vite 6）。
FROM node:24-alpine AS build

WORKDIR /src
# 先只拷依赖清单：改业务代码不会让 npm ci 这一层缓存失效
COPY fssc-web/package.json fssc-web/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY fssc-web ./
# vite.config.js 的 build.outDir = dist36（且 emptyOutDir:false）⇒ 产物落在 /src/dist36
RUN npm run build

FROM nginx:1.27-alpine
COPY docker/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist36 /usr/share/nginx/html
EXPOSE 80
