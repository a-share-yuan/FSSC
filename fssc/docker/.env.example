# ============================================================================
# FSSC docker compose 环境变量样例
# 用法：cd fssc/docker && cp .env.example .env   （.env 已被 .gitignore 忽略）
# docker compose 会自动读同目录的 .env，无需额外参数。
# ============================================================================

# ---------- 必填（留空即启动失败，这是有意的）----------
# MySQL root 口令，两库共用；同时用作 compose 里 db 服务的 MYSQL_ROOT_PASSWORD
FSSC_DB_PASSWORD=

# JWT 签名密钥，必须 ≥ 32 字节强随机串：openssl rand -base64 48
# 多实例部署时所有实例必须同一个值，否则表现为"刚登录就被踢"
FSSC_JWT_SECRET=

# ---------- 演示数据 ----------
# 整库 dump 目录（相对本文件所在目录）。每个 .sql 自带 CREATE DATABASE + USE，
# 主库 fssc 与影像库 fssc_image 一起建好；只在 db-data 卷为空的那次 up 执行。
FSSC_DUMP_DIR=../../db/Dump20261102

# ---------- 端口 ----------
# 前端对外端口（浏览器访问的就是它）
FSSC_WEB_PORT=8080
# 后端端口，只绑 127.0.0.1，供本机排查接口用
FSSC_API_PORT=8089
