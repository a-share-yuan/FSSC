{
  "schema": "fssc.tenant-preset/1",
  "note": "三档能力集合配方。纯数据描述，不含售卖语义；运行期由 OnboardService 消费，离线工具由 setup_tenant_preset.py 消费。菜单收敛靠套餐特性码，审批强度靠流程模板与路由，二者都落在数据上，业务代码不做档位判断。",
  "presets": {
    "EXPENSE": {
      "label": "费用报销版",
      "audience": "只需提单、两级审批、基础报表的中小团队",
      "packageCode": "FC_BASIC",
      "opMode": "EXPENSE",
      "expectedMenu": { "domains": 5, "pages": 21 },
      "flow": {
        "modelKey": "CLAIM_BASIC",
        "modelName": "费用报销（两级审批）",
        "bpmn": "scripts/claim_basic.bpmn20.xml",
        "nodes": [
          { "nodeKey": "Task_1", "nodeName": "部门经理审批", "role": "DEPT_MANAGER" },
          { "nodeKey": "Task_2", "nodeName": "财务审核", "role": "FIN_AUDIT" }
        ],
        "routes": [
          {
            "bizType": "EXP_CLAIM",
            "subType": null,
            "companyId": null,
            "amountMin": null,
            "amountMax": null,
            "priority": 40,
            "configName": "报销版两级审批"
          }
        ]
      },
      "seed": {
        "roles": ["ADMIN", "COMMON_EMP", "DEPT_MANAGER", "FIN_AUDIT"],
        "numberRules": ["EXP_CLAIM", "EXP_APPLY", "EXP_LOAN"],
        "businessSeed": "default"
      }
    },
    "CONTROL": {
      "label": "费控版",
      "audience": "需要申请、标准、预算与三级审批的成长型公司",
      "packageCode": "FC_STANDARD",
      "opMode": "CONTROL",
      "expectedMenu": { "domains": 5, "pages": 30 },
      "flow": {
        "modelKey": "CLAIM_STD",
        "modelName": "费用报销（三级审批）",
        "bpmn": "scripts/claim_std.bpmn20.xml",
        "nodes": [
          { "nodeKey": "Task_1", "nodeName": "部门经理审批", "role": "DEPT_MANAGER" },
          { "nodeKey": "Task_2", "nodeName": "财务审核", "role": "FIN_AUDIT" },
          { "nodeKey": "Task_3", "nodeName": "财务总监审批", "role": "CFO" }
        ],
        "routes": [
          {
            "bizType": "EXP_CLAIM",
            "subType": null,
            "companyId": null,
            "amountMin": null,
            "amountMax": null,
            "priority": 40,
            "configName": "费控版三级审批"
          }
        ]
      },
      "seed": {
        "roles": ["ADMIN", "COMMON_EMP", "DEPT_MANAGER", "FIN_AUDIT", "CFO"],
        "numberRules": ["EXP_CLAIM", "EXP_APPLY", "EXP_LOAN", "EXP_PAY"],
        "businessSeed": "default"
      }
    },
    "SHARED": {
      "label": "共享版",
      "audience": "已有共享中心、需要全量财务作业与运营配置的集团",
      "packageCode": "FC_PRO",
      "opMode": "SHARED",
      "expectedMenu": { "domains": 17, "pages": 110 },
      "flow": {
        "modelKey": "CLAIM",
        "modelName": "系统自带报销流程（沿用）",
        "bpmn": null,
        "nodes": [],
        "routes": [],
        "inherit": true
      },
      "seed": {
        "roles": ["ADMIN", "COMMON_EMP", "DEPT_MANAGER", "FIN_AUDIT", "CFO"],
        "numberRules": ["EXP_CLAIM", "EXP_APPLY", "EXP_LOAN", "EXP_PAY", "BG_SCHEME", "BUDGET_ADJUST", "TAX_DECLARATION", "PAY_BATCH"],
        "businessSeed": "default"
      }
    }
  },
  "businessSeed": {
    "note": "新租户的最小可开单闭包。绝不克隆演示租户的 9 家公司 / 2712 个科目 / 453 个用户；一律按业务键新建，所有外键与 ancestors 用新建后的 ID 重映射。key 仅供装配器内部引用，落库只认 code。",
    "company": { "code": "SEED-HQ", "name": "默认公司主体", "shortName": "默认主体" },
    "subjects": [
      { "key": "ROOT", "code": "6602", "name": "管理费用", "parentKey": null, "level": 1, "isLeaf": 0 },
      { "key": "OFFICE", "code": "660208", "name": "管理费用-办公费", "parentKey": "ROOT", "level": 2, "isLeaf": 1 }
    ],
    "depts": [
      { "key": "ROOT", "code": "SEED-ROOT", "name": "总部", "parentKey": null, "level": 1 },
      { "key": "OFFICE", "code": "SEED-OFFICE", "name": "综合管理部", "parentKey": "ROOT", "level": 2 }
    ],
    "items": [
      { "code": "SEED-OFFICE", "name": "办公费", "subjectKey": "OFFICE", "needInvoice": 1 }
    ],
    "users": [
      { "userName": "seed_manager", "nickName": "部门经理（种子）", "deptKey": "OFFICE", "roles": ["DEPT_MANAGER"] },
      { "userName": "seed_auditor", "nickName": "财务审核（种子）", "deptKey": "OFFICE", "roles": ["FIN_AUDIT"] },
      { "userName": "seed_director", "nickName": "财务总监（种子）", "deptKey": "OFFICE", "roles": ["CFO"] }
    ],
    "files": [
      { "fileName": "seed-invoice.pdf", "path": "/seed/seed-invoice.pdf" }
    ]
  },
  "notes": [
    "sys_menu 是全局表，菜单打码在交付打包时完成；切换档位只改 pf_tenant_package 与档位路由，绝不改菜单。",
    "一套系统服务一个客户，安装完成时租户自带全量的组织、岗位、流程模型与路由；切换档位不新建租户、不复制主数据。",
    "businessSeed 只供离线初始化工具使用；运行期切换档位不消费此段，也不会新建公司 / 部门 / 科目 / 用户。",
    "features 是登录时写入 JWT 的快照，切换档位后必须重新登录才能看到新菜单。",
    "pf_tenant.op_mode 为版本标记：新部署保持 NULL，管理员首登跳引导页；非空直接进工作台。已上线系统升级时执行 V1.6.92_tenant_op_mode_backfill.sql 回填 SHARED，避免被引导页拦住。",
    "开源定位：档位只是能力集合，不含任何人数、公司数、月单据量、存储配额，也不含价格或临时提额机制。pf_package 的 price_*/max_* 是历史结构列，一律保持 0（0=不限、0=无价格），装配阶段不得写入非零值。"
  ]
}
