<!--
  FSSC 日志配置（P0-B1 可观测性地基）。

  要点：
  1) 每行日志带 [traceId]，与 TraceIdFilter 写入的 MDC 对齐 —— 一次请求的全部日志可用 traceId 串联；
     非请求线程（启动、定时任务）traceId 为空，显示为 []。
  2) 同时输出控制台 + 滚动文件：生产必须留档，事故回溯不能只靠控制台缓冲。
      文件目录 ${LOG_HOME:-./logs}，单文件 100MB、保留 30 天、总量上限 3GB，自动滚动压缩。
  3) 刻意不 include Spring Boot 的 defaults.xml：Boot 4 的 logging 模块路径有调整，
     自包含定义可避免版本差异导致启动即报找不到资源。日志级别仍由 application.yml 的
     logging.level.* 在容器启动后覆盖（Boot 的 LoggingApplicationListener 负责）。
-->
<configuration>

    <property name="LOG_HOME" value="${LOG_HOME:-./logs}"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%X{traceId:-}] --- [%15.15t] %-40.40logger{39} : %m%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/fssc-server.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/fssc-server.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 错误单独留一份，排障时免于在 INFO 里翻找 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/fssc-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/fssc-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>60</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

</configuration>
