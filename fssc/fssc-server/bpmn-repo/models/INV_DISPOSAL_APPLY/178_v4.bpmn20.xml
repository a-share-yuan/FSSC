    <bpmn:userTask id="IVD_6" name="处置执行与账务【总账会计】" flowable:candidateGroups="FIN_GL" />
    <bpmn:sequenceFlow id="Flow_in_IVD_6" sourceRef="GW_IVD_AMT" targetRef="IVD_6" />
    <bpmn:sequenceFlow id="Flow_back_IVD_5" sourceRef="IVD_5" targetRef="IVD_6" />
    <bpmn:sequenceFlow id="Flow_back_IVD_4" sourceRef="IVD_4" targetRef="IVD_6" />
    <bpmn:endEvent id="EndEvent_1" name="结束" />
    <bpmn:sequenceFlow id="Flow_end" sourceRef="IVD_6" targetRef="EndEvent_1" />
