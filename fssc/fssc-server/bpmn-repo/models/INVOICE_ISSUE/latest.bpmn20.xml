  <bpmn:process id="INVOICE_ISSUE" name="开票与收入确认审批流程（含服务申请档）" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="开始" />
    <bpmn:exclusiveGateway id="GW_INV" name="业务类型分档" default="Flow_in_Task_2" />
    <bpmn:sequenceFlow id="Flow_start_gw" sourceRef="StartEvent_1" targetRef="GW_INV" />
    <bpmn:userTask id="Task_2" name="直属上级审核【部门负责人】" flowable:candidateGroups="DIRECT_SUPERVISOR" />
    <bpmn:sequenceFlow id="Flow_in_Task_2" sourceRef="GW_INV" targetRef="Task_2" />
    <bpmn:userTask id="Task_3" name="基地财务经理审核【基地财务经理】" flowable:candidateGroups="BASE_FIN_MANAGER" />
    <bpmn:sequenceFlow id="Flow_in_Task_3" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:userTask id="Task_4" name="项目中心总监审批【项目中心总监】" flowable:candidateGroups="PM_CENTER_DIRECTOR" />
    <bpmn:sequenceFlow id="Flow_in_Task_4" sourceRef="Task_3" targetRef="Task_4" />
    <bpmn:userTask id="Task_5" name="财务总监审批【财务总监】" flowable:candidateGroups="CFO" />
    <bpmn:sequenceFlow id="Flow_in_Task_5" sourceRef="Task_4" targetRef="Task_5" />
    <bpmn:userTask id="Task_6" name="共享会计复核【共享会计】" flowable:candidateGroups="FSSC_AUDITOR" />
    <bpmn:sequenceFlow id="Flow_in_Task_6" sourceRef="Task_5" targetRef="Task_6" />
    <bpmn:userTask id="ARC_1" name="服务申请受理【应收会计】" flowable:candidateGroups="FIN_AR" />
    <bpmn:sequenceFlow id="Flow_GW_INV_ARC_1" sourceRef="GW_INV" targetRef="ARC_1" name="服务申请档"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${billType == 'AR_CLAIM'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:userTask id="ARC_2" name="研发中心总监审批【研发中心总监】" flowable:candidateGroups="RND_CENTER_DIRECTOR" />
    <bpmn:sequenceFlow id="Flow_ARC_2" sourceRef="ARC_1" targetRef="ARC_2" />
    <bpmn:sequenceFlow id="Flow_sgjoin_ARC_2" sourceRef="ARC_2" targetRef="Task_6" />
    <bpmn:endEvent id="EndEvent_1" name="结束" />
    <bpmn:sequenceFlow id="Flow_end" sourceRef="Task_6" targetRef="EndEvent_1" />
  </bpmn:process>
