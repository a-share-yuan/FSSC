    <bpmn:userTask id="TB_2" name="票据财务审核【财务经理】" flowable:candidateGroups="FIN_MANAGER" />
    <bpmn:sequenceFlow id="Flow_TB_2" sourceRef="TB_1" targetRef="TB_2" />
    <bpmn:userTask id="TB_3" name="票据总监审批【财务总监】" flowable:candidateGroups="CFO" />
    <bpmn:sequenceFlow id="Flow_TB_3" sourceRef="TB_2" targetRef="TB_3" />
    <bpmn:sequenceFlow id="Flow_sgjoin_TB_3" sourceRef="TB_3" targetRef="EndEvent_1" />
    <bpmn:userTask id="TPF_1" name="失败原因核查与重试【资金专员】" flowable:candidateGroups="FUND_STAFF" />
    <bpmn:sequenceFlow id="Flow_GW_TRP_TPF_1" sourceRef="GW_TRP" targetRef="TPF_1" name="支付失败处理档"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${billType == 'TR_PAY_FAIL'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_sgjoin_TPF_1" sourceRef="TPF_1" targetRef="Task_9" />
    <bpmn:endEvent id="EndEvent_1" name="结束" />
    <bpmn:sequenceFlow id="Flow_end" sourceRef="Task_9" targetRef="EndEvent_1" />
  </bpmn:process>
