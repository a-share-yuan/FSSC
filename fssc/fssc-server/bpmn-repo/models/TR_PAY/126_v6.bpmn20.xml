    <bpmn:userTask id="Task_6" name="财务总监审批【财务总监】" flowable:candidateGroups="CFO" />
    <bpmn:sequenceFlow id="Flow_in_Task_6" sourceRef="Task_5" targetRef="Task_6" />
    <bpmn:userTask id="Task_7" name="总裁审批【总裁】" flowable:candidateGroups="PRESIDENT" />
    <bpmn:sequenceFlow id="Flow_in_Task_7" sourceRef="Task_6" targetRef="Task_7" />
    <bpmn:userTask id="Task_8" name="共享主管监督【共享主管】" flowable:candidateGroups="FSSC_SUPERVISOR" />
    <bpmn:sequenceFlow id="Flow_in_Task_8" sourceRef="Task_7" targetRef="Task_8" />
    <bpmn:userTask id="Task_9" name="网银执行与回单【资金付款岗】" flowable:candidateGroups="FUND_PAY_STAFF" />
    <bpmn:sequenceFlow id="Flow_in_Task_9" sourceRef="Task_8" targetRef="Task_9" />
    <bpmn:userTask id="TB_1" name="票据业务登记【资金专员】" flowable:candidateGroups="FUND_STAFF" />
