    <bpmn:startEvent id="StartEvent_1" name="开始" />
    <bpmn:exclusiveGateway id="GW_TRP" name="支付方式分档" default="Flow_in_Task_2" />
    <bpmn:sequenceFlow id="Flow_start_gw" sourceRef="StartEvent_1" targetRef="GW_TRP" />
    <bpmn:userTask id="Task_2" name="付款指令编制【资金专员】" flowable:candidateGroups="FUND_STAFF" />
    <bpmn:sequenceFlow id="Flow_in_Task_2" sourceRef="GW_TRP" targetRef="Task_2" />
