    <bpmn:sequenceFlow id="Flow_in_Task_3" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:userTask id="Task_4" name="基地总经理审批【基地总经理】" flowable:candidateGroups="BASE_GM" />
