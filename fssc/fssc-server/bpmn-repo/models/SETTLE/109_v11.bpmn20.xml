  <bpmn:process id="SETTLE" name="对公付款审批流程（采购付款/预付/税金缴纳/薪酬发放档）" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="开始" />
    <bpmn:exclusiveGateway id="GW_ST" name="付款类型分档" default="Flow_in_Task_2" />
