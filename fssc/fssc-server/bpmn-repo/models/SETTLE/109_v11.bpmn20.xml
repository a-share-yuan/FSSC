    <bpmn:userTask id="Task_2" name="扫描单据【财务扫描岗】" flowable:candidateGroups="SCAN_STAFF" />
    <bpmn:sequenceFlow id="Flow_in_Task_2" sourceRef="GW_ST" targetRef="Task_2" />
    <bpmn:userTask id="Task_4" name="部门经理审核【部门经理】" flowable:candidateGroups="DEPT_MANAGER" />
    <bpmn:sequenceFlow id="Flow_in_Task_4" sourceRef="Task_2" targetRef="Task_4" />
    <bpmn:userTask id="Task_7" name="财务共享审核【共享会计】" flowable:candidateGroups="FSSC_AUDITOR" />
    <bpmn:sequenceFlow id="Flow_in_Task_7" sourceRef="Task_4" targetRef="Task_7" />
    <bpmn:userTask id="Task_8" name="基地财务经理审核【基地财务经理】" flowable:candidateGroups="BASE_FIN_MANAGER" />
    <bpmn:sequenceFlow id="Flow_in_Task_8" sourceRef="Task_7" targetRef="Task_8" />
    <bpmn:exclusiveGateway id="GW_ST_AMT" name="金额授权" default="Flow_in_Task_14" />
    <bpmn:sequenceFlow id="Flow_in_GW_ST_AMT" sourceRef="Task_8" targetRef="GW_ST_AMT" />
    <bpmn:userTask id="Task_13" name="总裁审批【总裁】" flowable:candidateGroups="PRESIDENT" />
    <bpmn:sequenceFlow id="Flow_GW_ST_AMT_Task_13" sourceRef="GW_ST_AMT" targetRef="Task_13"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt; 2000000}</bpmn:conditionExpression></bpmn:sequenceFlow>
        <bpmn:userTask id="Task_11" name="财务总监审批【财务总监】" flowable:assignee="${assignee}">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${Task_11_assignees}" flowable:elementVariable="assignee">
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">${nrOfCompletedInstances == nrOfInstances}</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_GW_ST_AMT_Task_11" sourceRef="GW_ST_AMT" targetRef="Task_11"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt; 500000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:userTask id="Task_14" name="付款制证与下推【总账会计】" flowable:candidateGroups="FIN_GL" />
        <bpmn:userTask id="Task_14_R" name="付款凭证复核【预制凭证审核岗】" flowable:candidateGroups="GL_VOUCHER_REVIEW" />
    <bpmn:sequenceFlow id="Flow_in_Task_14" sourceRef="GW_ST_AMT" targetRef="Task_14" />
    <bpmn:sequenceFlow id="Flow_back_Task_13" sourceRef="Task_13" targetRef="Task_14" />
    <bpmn:sequenceFlow id="Flow_back_Task_11" sourceRef="Task_11" targetRef="Task_14" />
    <bpmn:userTask id="SP_1" name="预付核销核对【共享会计】" flowable:candidateGroups="FSSC_AUDITOR" />
    <bpmn:sequenceFlow id="Flow_GW_ST_SP_1" sourceRef="GW_ST" targetRef="SP_1" name="预付核销档"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${billType == 'PREPAY'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:userTask id="SP_2" name="预付复核【基地财务经理】" flowable:candidateGroups="BASE_FIN_MANAGER" />
    <bpmn:sequenceFlow id="Flow_SP_2" sourceRef="SP_1" targetRef="SP_2" />
    <bpmn:sequenceFlow id="Flow_sgjoin_SP_2" sourceRef="SP_2" targetRef="Task_14" />
    <bpmn:userTask id="ST_1" name="税单核对【应付审核】" flowable:candidateGroups="FIN_AP" />
    <bpmn:sequenceFlow id="Flow_GW_ST_ST_1" sourceRef="GW_ST" targetRef="ST_1" name="税金缴纳档"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${billType == 'GL_TAX_PAY'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:userTask id="ST_2" name="税缴复核【基地财务经理】" flowable:candidateGroups="BASE_FIN_MANAGER" />
    <bpmn:sequenceFlow id="Flow_ST_2" sourceRef="ST_1" targetRef="ST_2" />
    <bpmn:sequenceFlow id="Flow_sgjoin_ST_2" sourceRef="ST_2" targetRef="Task_14" />
    <bpmn:userTask id="SS_1" name="工资表复核【财务审核岗】" flowable:candidateGroups="FIN_AUDIT" />
    <bpmn:sequenceFlow id="Flow_GW_ST_SS_1" sourceRef="GW_ST" targetRef="SS_1" name="薪酬发放档"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${billType == 'GL_SALARY_PAY'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:userTask id="SS_2" name="发放指令确认【出纳】" flowable:candidateGroups="CASHIER" />
    <bpmn:sequenceFlow id="Flow_SS_2" sourceRef="SS_1" targetRef="SS_2" />
    <bpmn:sequenceFlow id="Flow_sgjoin_SS_2" sourceRef="SS_2" targetRef="Task_14" />
    <bpmn:endEvent id="EndEvent_1" name="结束" />
    <bpmn:sequenceFlow id="Flow_end" sourceRef="Task_14" targetRef="Task_14_R" />
        <bpmn:sequenceFlow id="Flow_end_r2" sourceRef="Task_14_R" targetRef="EndEvent_1" />
  </bpmn:process>
